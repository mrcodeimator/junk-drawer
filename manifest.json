{
  "manifestVersion": 5,
  "id": "com.junkdrawer.search",
  "name": "Junk Drawer",
  "version": "0.9.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "27.0.0"
  },
  "entrypoints": [
    {
      "type": "command",
      "id": "openSearch",
      "label": {
        "default": "Open Junk Drawer"
      }
    },
    {
      "type": "panel",
      "id": "junkDrawerPanel",
      "label": {
        "default": "Junk Drawer"
      },
      "minimumSize": { "width": 280, "height": 160 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 300, "height": 200 },
      "preferredFloatingSize": { "width": 520, "height": 420 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium", "lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light"],
      "species": ["generic"]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  }
}
